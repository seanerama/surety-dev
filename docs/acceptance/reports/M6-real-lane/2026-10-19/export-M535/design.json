    "differences": [
      {
        "target": "android",
        "what": "Landscape lists the plant cards in two columns, read row by row in the API's order.",
        "why": "A phone in landscape is short; two columns keep more plants on screen without changing the order."
      },
      {
        "target": "android",
        "what": "The unreachable state also stands for the network being unavailable to the app (android.permission.INTERNET); the web has no permission state.",
        "why": "The inventory owes a permission_denied state on android only; INTERNET is granted at install, so no prompt or settings screen is drawn."
      }
    ]
  },
