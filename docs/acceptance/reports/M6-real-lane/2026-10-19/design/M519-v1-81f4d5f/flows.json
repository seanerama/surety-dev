{
  "flows": [
    {
      "key": "momentum-loop",
      "title": "Momentum lab: predict, run, compare",
      "requirements": [
        "R6",
        "R7",
        "R8"
      ],
      "steps": [
        {
          "key": "momentum.open",
          "title": "Open the momentum lab from its tab or its address",
          "requirement": "R8",
          "interfaces": [
            "page document",
            "design tokens",
            "main.mjs entry"
          ]
        },
        {
          "key": "momentum.set-up",
          "title": "Set up the experiment within the allowed ranges",
          "requirement": "R8",
          "interfaces": [
            "RANGES",
            "validateMomentum / validateFriction / validateTrajectory / validateScore"
          ]
        },
        {
          "key": "momentum.predict",
          "title": "Enter a prediction (step 1, Predict)",
          "requirement": "R8",
          "interfaces": [
            "validateMomentum / validateFriction / validateTrajectory / validateScore",
            "score"
          ]
        },
        {
          "key": "momentum.run",
          "title": "Run: simulate and watch the run in 3D (step 2, Run)",
          "requirement": "R7",
          "interfaces": [
            "simulateMomentum",
            "main.mjs entry"
          ]
        },
        {
          "key": "momentum.compare",
          "title": "Compare the prediction with the simulation: error, score and bar (step 3, Compare)",
          "requirement": "R8",
          "interfaces": [
            "simulateMomentum",
            "score"
          ]
        },
        {
          "key": "momentum.explain",
          "title": "Read why it came out this way: the law, the equation with the numbers, why",
          "requirement": "R6",
          "interfaces": [
            "simulateMomentum"
          ]
        },
        {
          "key": "momentum.replay",
          "title": "Play, pause or replay the run",
          "requirement": "R7",
          "interfaces": [
            "main.mjs entry"
          ]
        }
      ]
    },
