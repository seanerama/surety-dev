  "interfaces": [
    {
      "name": "list_plants",
      "module": "api",
      "kind": "http",
      "path": "GET /api/plants",
      "request": {
        "type": "null"
      },
      "response": {
        "type": "object",
        "properties": {
          "plants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "intervalDays": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 365,
                  "unit": "days"
                },
                "lastWatered": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "due": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "intervalDays",
                "lastWatered",
                "due"
              ]
            },
            "collection": true
          }
        },
        "required": [
          "plants"
        ]
      },
      "errors": [
        {
          "code": "method_not_allowed",
          "when": "405: a method other than GET, POST on this route; the answer carries Allow: GET, POST"
        },
        {
          "code": "internal",
          "when": "500: an unexpected failure; no stack trace or internal detail"
        }
      ],
      "shape_known": true
    },
