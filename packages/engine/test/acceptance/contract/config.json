{
  "$comment": "Verifier's expected closed configuration (build spec §6 correction 20; D1 A.9; Review B17; E18). Durations are integer seconds unless `unit` says otherwise. `fixed` keys accept only their default. Tests read expectations from this file, never from the engine.",
  "engine": {
    "tick_interval": { "default": 30, "min": 5, "max": 600, "unit": "s" },
    "tick_budget": { "default": 20, "min": 5, "max": 300, "unit": "s" },
    "tick_step_budget": { "default": 5, "min": 1, "max": 60, "unit": "s" },
    "lease_ttl": { "default": 90, "min": 30, "max": 600, "unit": "s" },
    "terminate_grace": { "default": 10, "min": 1, "max": 60, "unit": "s" },
    "kill_grace": { "default": 5, "min": 1, "max": 30, "unit": "s" },
    "api_latency_bound": { "default": 250, "min": 50, "max": 2000, "unit": "ms" },
    "request_body_deadline": { "default": 10, "min": 1, "max": 60, "unit": "s" },
    "body_cap": { "default": 1048576, "fixed": true, "unit": "bytes" },
    "upload_cap": { "default": 8388608, "fixed": true, "unit": "bytes" },
    "backup_keep": { "default": 14, "min": 1, "max": 365, "unit": "count" },
    "max_concurrent_runs": { "default": 2, "min": 1, "max": 8, "unit": "count" },
    "api_port": { "default": 7227, "min": 1024, "max": 65535, "unit": "port" },
    "api_authority": { "default": "127.0.0.1:<api_port>", "allowed": ["127.0.0.1:<api_port>", "localhost:<api_port>"], "unit": "authority" },
    "git_deadline": { "default": 60, "min": 1, "max": 600, "unit": "s" },
    "git_deadline_long": { "default": 600, "min": 60, "max": 3600, "unit": "s" },
    "git_output_cap": { "default": 8388608, "min": 65536, "max": 268435456, "unit": "bytes" },
    "decision_targets": { "default": {}, "unit": "map of DecisionKind to seconds", "value_min": 300, "value_max": 2592000, "not_overridable": ["stop_confirm", "abandon_confirm"] }
  },
  "decision_target_defaults": {
    "$comment": "Effective defaults for the eleven decision kinds enabled in M1 (build spec §3). D1 A.8 for nine; RN R4 adds two, given the targets of their siblings. null = no target (A.8 'none').",
    "blocker": 14400,
    "out_of_band_change": 14400,
    "stop_confirm": null,
    "abandon_confirm": null,
    "policy_widening": 172800,
    "finding_disposition": 86400,
    "severity_lower": 86400,
    "finding_applicability_exclusion": 86400,
    "check_correction_tightening": 86400,
    "check_correction_loosening": 86400,
    "check_correction_unclassifiable": 86400
  },
  "project": {
    "$comment": "Ungoverned project keys, held in .surety/policy.json and changed through POST /v1/projects/:p/policy (D1 §11.4; RN R2). Governed keys (protected_paths, check_commands, check_discovery, runner_config, result_collection, required_checks) live in .surety/checks/protected-policy.json and are not listed here.",
    "max_concurrent_runs": { "default": 1, "min": 1, "max": 1, "unit": "count" },
    "max_chained_roles": { "default": 1, "min": 1, "max": 6, "unit": "count" },
    "preflight_refusals_max": { "default": 3, "min": 1, "max": 10, "unit": "count" },
    "repair_attempts_max": { "default": 3, "min": 0, "max": 10, "unit": "count" },
    "no_progress_max": { "default": 2, "min": 1, "max": 5, "unit": "count" },
    "deadline_builder": { "default": 2700, "min": 300, "max": 10800, "unit": "s" },
    "deadline_verifier": { "default": 1800, "min": 300, "max": 10800, "unit": "s" },
    "deadline_reviewer": { "default": 1200, "min": 300, "max": 10800, "unit": "s" },
    "deadline_architect": { "default": 1800, "min": 300, "max": 10800, "unit": "s" },
    "session_idle_timeout": { "default": 1200, "min": 60, "max": 7200, "unit": "s" },
    "record_retention_days": { "default": 90, "min": 7, "max": 3650, "unit": "days" },
    "observation_cadence": { "default": 30, "min": 10, "max": 3600, "unit": "s" },
    "observation_freshness_bound": { "default": 90, "min": 30, "max": 86400, "unit": "s" },
    "budget_run_billable_tokens": { "default": 1500000, "min": 10000, "max": 50000000, "unit": "tokens" },
    "budget_day_verified_usd": { "default": 40, "min": 0, "max": 10000, "unit": "usd", "integer": false },
    "budget_day_unknown_tokens": { "default": 2000000, "min": 0, "max": 100000000, "unit": "tokens" },
    "snapshot_max_files": { "default": 5000, "min": 1, "max": 100000, "unit": "count" },
    "snapshot_max_bytes": { "default": 104857600, "min": 1048576, "max": 1073741824, "unit": "bytes" },
    "snapshot_max_file_bytes": { "default": 10485760, "min": 1024, "max": 1073741824, "unit": "bytes" }
  }
}
